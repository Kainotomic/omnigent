# Variable NAMES for the Kainotomic Dokploy entries. Values live only in
# Dokploy's encrypted compose environment — never in this repository.

# ── docker-compose.server.yaml ───────────────────────────
POSTGRES_PASSWORD=                      # openssl rand -hex 32 (URL-safe; goes raw into DATABASE_URL)
# POSTGRES_USER=omnigent
# POSTGRES_DB=omnigent
OMNIGENT_OIDC_ISSUER=https://accounts.google.com
OMNIGENT_OIDC_CLIENT_ID=
OMNIGENT_OIDC_CLIENT_SECRET=
OMNIGENT_OIDC_COOKIE_SECRET=            # openssl rand -hex 32 (new; do not reuse Kainogent's)
OMNIGENT_OIDC_REDIRECT_URI=https://kainogent.kainotomic.com/auth/callback
OMNIGENT_OIDC_ALLOWED_DOMAINS=          # comma-separated (decision 2)
# OMNIGENT_OIDC_SESSION_TTL_HOURS=720
# OMNIGENT_OIDC_ALLOW_INVITES=
# OMNIGENT_WS_ALLOWED_ORIGINS=https://kainogent.kainotomic.com
# OMNIGENT_GRANT_MAX_LIFETIME_DAYS=30
# OMNIGENT_FEATURES=

# ── docker-compose.workspace.yaml (one entry per user) ───
OMNIGENT_SERVER_URL=https://kainogent.kainotomic.com
OMNIGENT_GATEWAY_API_KEY=               # this user's CLIProxy key (decision 7)
# OMNIGENT_GATEWAY_BASE_URL=https://openai.kainotomic.com
# OMNIGENT_GATEWAY_ANTHROPIC_MODEL=      # override the catalog's anthropic default (harness-templates/gateway-models.jsonl)
# OMNIGENT_GATEWAY_OPENAI_MODEL=         # override the catalog's openai default
# OMNIGENT_GATEWAY_FORCE=0
# OMNIGENT_EGRESS_DENY_IP=146.190.116.149   # dokploy-root; blocked from workspaces
